.global _start

.text

_start:
main:
    # Inicialización del entorno de pruebas
    la   s0, pruebas_bcd
    la   s1, signos_esperados
    la   s2, floats_esperados
    la   s3, resultados_obtenidos

    la   t0, num_casos
    lw   s4, 0(t0)
    li   s5, 0                      # Contador de errores

# Bucle principal para iterar sobre los casos de prueba
bucle_pruebas:
    beq  s4, zero, fin_pruebas

    mv   a0, s0                     # Dirección del arreglo BCD
    lw   a1, 0(s1)                  # Valor del signo (0 positivo, 1 negativo)

    jal  ra, bcd_a_float

    sw   a0, 0(s3)                  # Guardar resultado obtenido

    # Comparación con la salida esperada
    lw   t0, 0(s2)
    beq  a0, t0, prueba_correcta

    addi s5, s5, 1                  # Incrementar si la prueba falla

prueba_correcta:
    addi s0, s0, 60                 # Avanzar al siguiente BCD (15 palabras x 4 bytes)
    addi s1, s1, 4                  # Avanzar dirección del signo
    addi s2, s2, 4                  # Avanzar esperado
    addi s3, s3, 4                  # Avanzar obtenido
    addi s4, s4, -1                 # Restar contador de casos restantes

    j    bucle_pruebas

fin_pruebas:
    la   t0, errores_total
    sw   s5, 0(t0)

fin:
    j    fin                        # Bucle de finalización del programa


# Conversión de BCD a IEEE-754 (32 bits)
# Entradas: a0 = dirección dígitos BCD, a1 = signo (0 pos, 1 neg)
# Salida: a0 = float codificado en 32 bits
bcd_a_float:
    # Obtención del bit de signo
    la   t7, sign_bits
    beq  a1, zero, signo_positivo
    addi t7, t7, 4                  # Dirección de signo negativo

signo_positivo:
    lw   a2, 0(t7)                  # Máscara de signo (0x00000000 o 0x80000000)

    la   t7, constante_100000
    lw   a1, 0(t7)                  # Cargar divisor para 5 decimales

    # Conversión de los primeros 10 dígitos (parte entera)
    li   t0, 0                      # Acumulador entero
    li   t1, 10                     # Contador de dígitos enteros

convertir_entero_bcd:
    beq  t1, zero, convertir_fraccion_bcd

    lw   t2, 0(a0)                  # Leer dígito
    add  t3, t0, t0                 # t0 * 2
    add  t4, t3, t3                 # t0 * 4
    add  t5, t4, t4                 # t0 * 8
    add  t4, t5, t3                 # t0 * 10 mediante sumas
    add  t0, t4, t2                 # Sumar dígito actual

    addi a0, a0, 4                  # Siguiente posición BCD
    addi t1, t1, -1
    j    convertir_entero_bcd

# Conversión de los 5 dígitos de la parte fraccionaria
convertir_fraccion_bcd:
    li   t1, 0                      # Acumulador fracción
    li   t2, 5                      # Contador de dígitos fraccionarios

convertir_fraccion_loop:
    beq  t2, zero, comprobar_cero

    lw   t3, 0(a0)                  # Leer dígito
    add  t4, t1, t1                 # 2x
    add  t5, t4, t4                 # 4x
    add  t4, t5, t5                 # 8x
    add  t5, t4, t1                 # 9x
    add  t1, t5, t1                 # 10x
    add  t1, t1, t3                 # Sumar dígito actual

    addi a0, a0, 4
    addi t2, t2, -1
    j    convertir_fraccion_loop

# Validación de caso especial cero
comprobar_cero:
    bne  t0, zero, numero_entero
    bne  t1, zero, numero_menor_uno

    mv   a0, a2                     # Retornar cero con su respectivo signo
    jr   ra

# Procesamiento para valores mayores o iguales a 1
numero_entero:
    la   t5, potencias2
    li   t3, 30                     # Exponente base máximo

buscar_potencia:
    lw   t2, 0(t5)
    bge  t0, t2, potencia_encontrada

    addi t5, t5, 4
    addi t3, t3, -1
    j    buscar_potencia

potencia_encontrada:
    la   t5, exp_fields_pos
    li   t4, 0

buscar_exp_pos:
    beq  t4, t3, exp_pos_encontrado
    addi t5, t5, 4
    addi t4, t4, 1
    j    buscar_exp_pos

exp_pos_encontrado:
    lw   a3, 0(t5)                  # Cargar campo de exponente IEEE-754
    sub  t4, t0, t2                 # Obtener residuo

    li   t7, 0                      # Acumulador de mantisa
    li   t3, 0                      # Contador de bits
    li   t8, 23                     # Límite de bits de mantisa
    la   t5, pesos_fraccion

fraccion_entero_loop:
    beq  t3, t8, fraccion_entero_guard

    add  t0, t1, t1                 # Duplicar decimales
    li   t1, 0
    bge  t0, a1, carry_fraccion_entero
    j    sin_carry_fraccion_entero

carry_fraccion_entero:
    sub  t0, t0, a1
    li   t1, 1

sin_carry_fraccion_entero:
    add  t4, t4, t4                 # Duplicar residuo
    add  t4, t4, t1
    mv   t1, t0

    bge  t4, t2, bit_uno_entero

    addi t3, t3, 1
    addi t5, t5, 4
    j    fraccion_entero_loop

bit_uno_entero:
    sub  t4, t4, t2
    lw   t0, 0(t5)
    add  t7, t7, t0                 # Acumular peso del bit en la mantisa

    addi t3, t3, 1
    addi t5, t5, 4
    j    fraccion_entero_loop

# Generación del bit de guardia para redondeo
fraccion_entero_guard:
    add  t0, t1, t1
    li   t1, 0
    bge  t0, a1, carry_guard_entero
    j    sin_carry_guard_entero

carry_guard_entero:
    sub  t0, t0, a1
    li   t1, 1

sin_carry_guard_entero:
    add  t4, t4, t4
    add  t4, t4, t1
    mv   t1, t0

    bge  t4, t2, guard_entero_uno
    li   t5, 0
    j    redondear_entero

guard_entero_uno:
    sub  t4, t4, t2
    li   t5, 1

redondear_entero:
    beq  t5, zero, ensamblar_float
    bne  t1, zero, hacer_round

    andi t0, t7, 1
    beq  t0, zero, ensamblar_float

hacer_round:
    addi t7, t7, 1

    la   t0, limite_mantisa
    lw   t0, 0(t0)
    bge  t7, t0, overflow_mantisa
    j    ensamblar_float

overflow_mantisa:
    li   t7, 0
    la   t0, paso_exponente
    lw   t0, 0(t0)
    add  a3, a3, t0
    j    ensamblar_float

# Procesamiento para valores estrictamente entre 0 y 1
numero_menor_uno:
    li   t3, -1
    mv   t4, t1

buscar_exponente_neg:
    bge  t4, a1, exponente_neg_encontrado
    add  t4, t4, t4
    addi t3, t3, -1
    j    buscar_exponente_neg

exponente_neg_encontrado:
    sub  t4, t4, a1                 # Remover 1 implícito

    la   t5, exp_fields_neg
    li   t0, -1

buscar_exp_neg:
    beq  t0, t3, exp_neg_encontrado
    addi t5, t5, 4
    addi t0, t0, -1
    j    buscar_exp_neg

exp_neg_encontrado:
    lw   a3, 0(t5)

    li   t7, 0
    li   t3, 0
    li   t8, 23
    la   t5, pesos_fraccion

fraccion_neg_loop:
    beq  t3, t8, fraccion_neg_guard
    add  t4, t4, t4
    bge  t4, a1, bit_uno_neg

    addi t3, t3, 1
    addi t5, t5, 4
    j    fraccion_neg_loop

bit_uno_neg:
    sub  t4, t4, a1
    lw   t0, 0(t5)
    add  t7, t7, t0

    addi t3, t3, 1
    addi t5, t5, 4
    j    fraccion_neg_loop

fraccion_neg_guard:
    add  t4, t4, t4
    bge  t4, a1, guard_neg_uno
    li   t5, 0
    j    redondear_neg

guard_neg_uno:
    sub  t4, t4, a1
    li   t5, 1

redondear_neg:
    beq  t5, zero, ensamblar_float
    bne  t4, zero, hacer_round_neg

    andi t0, t7, 1
    beq  t0, zero, ensamblar_float

hacer_round_neg:
    addi t7, t7, 1
    la   t0, limite_mantisa
    lw   t0, 0(t0)
    bge  t7, t0, overflow_mantisa_neg
    j    ensamblar_float

overflow_mantisa_neg:
    li   t7, 0
    la   t0, paso_exponente
    lw   t0, 0(t0)
    add  a3, a3, t0

# Unión de las tres partes del formato IEEE-754
ensamblar_float:
    or   a0, a2, a3                 # Combinar signo y exponente
    or   a0, a0, t7                 # Combinar mantisa
    jr   ra


