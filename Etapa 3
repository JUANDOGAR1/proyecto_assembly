###############################################################################

# Bit 31 = signo
mascara_signo:
    .word 0x80000000                   # Máscara para obtener el bit de signo

# Bits 30..23 = exponente
mascara_exponente:
    .word 0x7F800000                   # Máscara para obtener el exponente

# Todos los bits excepto el signo
mascara_magnitud:
    .word 0x7FFFFFFF                   # Elimina únicamente el bit de signo

# Aproximadamente 0.0000011920929
# Usado como límite de underflow en la versión original
limite_underflow:
    .word 0x36A00000                   # Valor IEEE usado como límite inferior

# 2147483648.0
limite_overflow:
    .word 0x4F000000                   # Valor IEEE usado como límite superior


